{
  "manifest_version": 3,
  "name": "WillAI-C Connect",
  "version": "0.1.0",
  "description": "Capture responses from supported AI websites and insert selected WillAI-C context into the composer.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "http://127.0.0.1:43821/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://chat.deepseek.com/*",
    "https://deepseek.com/*",
    "https://*.deepseek.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "WillAI-C Connect", "default_popup": "popup.html" },
  "content_scripts": [{
    "matches": [
      "https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*",
      "https://chat.deepseek.com/*", "https://deepseek.com/*", "https://*.deepseek.com/*"
    ],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
