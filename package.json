{
  "name": "willai-c",
  "version": "0.3.1",
  "private": true,
  "description": "WillAI-C — a workspace-centered AI productivity desktop app with an integrated Chromium browser.",
  "main": "src/main/index.cjs",
  "scripts": {
    "dev": "npm run rebuild:electron && concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build",
    "start": "npm run rebuild:electron && electron .",
    "dist": "npm run build && electron-builder --publish never",
    "typecheck": "tsc --noEmit",
    "test": "npm run rebuild:node && node --test",
    "rebuild:node": "npm rebuild better-sqlite3 --no-audit --no-fund",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3"
  },
  "dependencies": {
    "markdown-it": "^14.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "better-sqlite3": "^13.2.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "concurrently": "^9.2.1",
    "electron": "^45.3.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "wait-on": "^8.0.4",
    "cross-env": "^10.1.0",
    "electron-builder": "^26.0.12",
    "@electron/rebuild": "^4.2.1"
  },
  "build": {
    "appId": "com.willai.connect",
    "productName": "WillAI-C",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/main/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "WillAI-C-${version}-Setup.${ext}"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
